# Öffentliche Werte aus dem "Connect"-Dialog des Supabase-Projekts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Öffentliche Produktionsadresse für Links in System-E-Mails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Serverseitiger Versand der Elternfreigabe. Die Absenderadresse muss beim
# Mailanbieter für die verwendete Domain verifiziert sein.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Trainer Hub <freigabe@example.org>

# Nur auf dem Server: Tokenausgabe für Elternmails und Fahrten-Versandwarteschlange.
SUPABASE_SERVICE_ROLE_KEY=

# Zufällige, getrennte Geheimnisse für ausschließlich serverseitige Worker.
# CARPOOL_CRON_SECRET muss dem Wert carpool_cron_secret in Supabase Vault entsprechen.
CARPOOL_CRON_SECRET=
# Vor Aktivierung des Onboarding-Cronjobs getrennt erzeugen und in Vercel/Vault hinterlegen.
ONBOARDING_CLEANUP_SECRET=
